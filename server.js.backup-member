/* =========================
   ADMIN — SUPPRIMER MEMBRE
========================= */

app.delete("/api/admin/members/:id", requireAdmin, (req, res) => {
  const db = readDatabase();

  const index = db.members.findIndex(
    (member) => member.id === req.params.id
  );

  if (index === -1) {
    return res.status(404).json({
      success: false,
      message: "Membre introuvable."
    });
  }

  db.members.splice(index, 1);

  db.notifications = db.notifications.filter(
    (item) => item.memberId !== req.params.id
  );

  db.messages = db.messages.filter(
    (item) =>
      item.senderId !== req.params.id &&
      item.receiverId !== req.params.id
  );

  writeDatabase(db);

  res.json({
    success: true,
    message: "Membre supprimé."
  });
});


