      String(password || ""),
      member.passwordHash
    );

    if (!passwordOk) {
      return res.status(401).json({
        success: false,
        message: "Email ou mot de passe incorrect."
      });
    }

    const token = createSession(member);

    res.json({
      success: true,
      message: "Connexion réussie.",
      token,
      member: publicMember(member)
    });

  } catch (error) {
    console.error(error);

    res.status(500).json({
      success: false,
      message: "Erreur lors de la connexion."
    });
