app.post("/api/register", async (req, res) => {
  try {
    const {
      name,
      email,
      password,
      country
    } = req.body;

    if (!name || !email || !password || !country) {
      return res.status(400).json({
        success: false,
        message: "Tous les champs obligatoires doivent être remplis."
      });
    }

    if (String(password).length < 6) {
      return res.status(400).json({
        success: false,
        message: "Le mot de passe doit contenir au moins 6 caractères."
      });
    }

    const db = readDatabase();

    if (db.members.length >= 500) {
      return res.status(400).json({
        success: false,
        message: "La limite de 500 membres a été atteinte."
      });
    }

    const normalizedEmail = cleanEmail(email);

    const existing = db.members.find(
      (member) => member.email === normalizedEmail
    );

    if (existing) {
      return res.status(409).json({
        success: false,
        message: "Cette adresse email est déjà utilisée."
      });
    }

    const passwordHash = await bcrypt.hash(password, 10);

    const member = {
      id: generateId(),
      name: String(name).trim(),
      email: normalizedEmail,
      passwordHash,
      country: String(country).trim(),
      skills: "",
      bio: "",
      ideas: "",
      links: "",
      photo: "",
      role: "member",
      status: "active",
      createdAt: new Date().toISOString()
    };

    db.members.push(member);

    db.notifications.push({
      id: generateId(),
      memberId: member.id,
      title: "Bienvenue dans l'équipe",
      message:
        "Bienvenue chez JS LENGE TECH SERVICES. Ton compte membre est maintenant actif.",
      read: false,
      createdAt: new Date().toISOString()
    });

    writeDatabase(db);

    res.status(201).json({
      success: true,
      message: "Inscription réussie. Tu es maintenant membre.",
      member: publicMember(member)
    });

  } catch (error) {
    console.error(error);

    res.status(500).json({
      success: false,
      message: "Erreur lors de l'inscription."
    });
  }
});


