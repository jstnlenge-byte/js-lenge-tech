        member: {
          id: "admin",
          name: "Mr Justin Lenge",
          email: "admin@jslenge.local",
          country: "République démocratique du Congo",
          role: "admin",
          status: "active"
        }
      });
    }

    const db = readDatabase();

    const member = db.members.find(
      (item) => item.email === normalizedEmail
    );

    if (!member) {
      return res.status(401).json({
